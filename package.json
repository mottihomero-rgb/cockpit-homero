{
  "name": "cockpit",
  "version": "1.1.0",
  "description": "Codex e Claude lado a lado, com acesso a tudo no Mac",
  "main": "main.js",
  "author": "Homero Motti",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --arm64",
    "test": "node --test tests/*.test.cjs && npm run test:acp",
    "test:ui": "node tests/auditoria-ui.cjs",
    "test:electron": "node tests/auditoria-electron.cjs",
    "test:acp": "node tests/teste-acp.js && node tests/teste-acp-ponte.js"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/xterm": "^5.5.0",
    "marked": "^12.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "ajv": "^6.12.6",
    "electron": "43.7.3",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "com.adsure.cockpit",
    "productName": "Cockpit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "acp.js",
      "cli-motors.js",
      "contas-cli.js",
      "codex-*.js",
      "preload.js",
      "preload-recorte.js",
      "plataforma.js",
      "nomes-conversa.js",
      "servidor-web.js",
      "package.json",
      "renderer/**/*",
      "!renderer/**/*.bak*",
      "!renderer/**/*.antes-*",
      "assets/**/*",
      "node_modules/@lydell/**/*",
      "node_modules/@xterm/**/*",
      "node_modules/marked/**/*",
      "node_modules/ws/**/*",
      "!**/*.d.ts",
      "!**/README.md",
      "!**/*.bak*",
      "!**/*.antes-*"
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "extraResources": [
      "ptybridge.py",
      {
        "from": "voz/ditado-vivo",
        "to": "ditado-vivo"
      },
      {
        "from": "voz/ocr-vision",
        "to": "ocr-vision"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "icon": "assets/icon.icns",
      "identity": "-",
      "extendInfo": {
        "NSCameraUsageDescription": "O Cockpit usa a câmera para você fotografar um rascunho no papel ou um quadro físico e mandar direto para o Claude ou o Codex.",
        "NSMicrophoneUsageDescription": "O Cockpit usa o microfone para o ditado: você fala e o texto aparece no campo da mensagem."
      }
    }
  }
}
