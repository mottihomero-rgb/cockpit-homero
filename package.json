{
  "name": "cockpit",
  "version": "1.2.0",
  "description": "Codex e Claude lado a lado, com acesso a tudo no Mac",
  "main": "main.js",
  "author": "Cliente",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --arm64 --publish never",
    "test": "node --test tests/*.test.cjs && npm run test:acp",
    "test:ui": "node tests/auditoria-ui.cjs && node tests/auditoria-renderer-interacao-26.cjs && node tests/auditoria-detalhes-interacao-26.cjs && node tests/auditoria-uuid-http-26.cjs && node tests/nomenclatura-ui-26.cjs",
    "test:electron": "node tests/auditoria-electron.cjs",
    "test:acp": "node tests/teste-acp.js && node tests/teste-acp-ponte.js",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "ajv": "^6.12.6",
    "electron": "43.7.3",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^12.0.2"
  },
  "build": {
    "appId": "com.adsure.cockpit",
    "productName": "Cockpit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "acp.js",
      "cli-motors.js",
      "contas-cli.js",
      "codex-*.js",
      "preload.js",
      "plataforma.js",
      "nomes-conversa.js",
      "nomes-agentes.js",
      "hora-da-fala.js",
      "mais-detalhes.js",
      "som-conclusao.js",
      "servidor-web.js",
      "package.json",
      "renderer/**/*",
      "!renderer/**/*.bak*",
      "!renderer/**/*.antes-*",
      "assets/**/*",
      "!assets/codex-notification.wav",
      "node_modules/@lydell/**/*",
      "node_modules/ws/**/*",
      "!**/*.d.ts",
      "!**/README.md",
      "!**/*.bak*",
      "!**/*.antes-*"
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "extraResources": [
      {
        "from": "assets/codex-notification.wav",
        "to": "codex-notification.wav"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "identity": "-",
      "extendInfo": {
        "NSCameraUsageDescription": "O Cockpit usa a câmera para você fotografar um rascunho no papel ou um quadro físico e mandar direto para o Claude ou o Codex.",
        "NSMicrophoneUsageDescription": "O Cockpit usa o microfone para o ditado: você fala e o texto aparece no campo da mensagem."
      },
      "artifactName": "Cockpit-${version}-Mac.${ext}",
      "extraResources": [
        "ptybridge.py",
        {
          "from": "voz/ditado-vivo",
          "to": "ditado-vivo"
        },
        {
          "from": "voz/ocr-vision",
          "to": "ocr-vision"
        }
      ],
      "hardenedRuntime": false
    },
    "afterSign": "scripts/assinar-mac.cjs",
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Cockpit-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cockpit",
      "language": "1046"
    }
  }
}
